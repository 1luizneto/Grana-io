# Configuração local do Grana.io
#
# Este arquivo é só um exemplo. O sistema sobe SEM .env, usando estes mesmos valores padrão
# de desenvolvimento. Para personalizar, copie para ".env" (que nunca é versionado) e altere
# só o que precisar; variáveis ausentes ou vazias continuam com o padrão.
# Referência: specs/001-infra-docker/contracts/environment.md

# --- Banco de dados (PostgreSQL) ---------------------------------------------------------

# Nome do banco principal.
POSTGRES_DB=grana

# Usuário do banco.
POSTGRES_USER=grana

# Senha do banco. ATENÇÃO: só vale na PRIMEIRA subida, quando o volume de dados é criado.
# Para trocar depois, é preciso apagar os dados (docker compose down -v) e subir de novo.
POSTGRES_PASSWORD=grana-dev-senha

# --- Backend (Django) ---------------------------------------------------------------------

# Chave secreta do Django. Vazia = chave padrão de desenvolvimento.
# Obrigatória se DJANGO_DEBUG=0: com a chave padrão a API se recusa a subir.
DJANGO_SECRET_KEY=

# Modo de desenvolvimento (1 = ligado, 0 = desligado).
DJANGO_DEBUG=1

# Hosts aceitos pela API, separados por vírgula. "*" só no modo de desenvolvimento.
# Se personalizar, INCLUA "localhost" (healthcheck) e "backend" (proxy da interface), além
# do IP da máquina. Ex.: localhost,backend,192.168.0.10
DJANGO_ALLOWED_HOSTS=*

# Origens extras que podem chamar a API pelo navegador, separadas por vírgula
# (ex.: http://localhost:3000). A própria interface do Grana.io NÃO precisa estar aqui.
DJANGO_CORS_ALLOWED_ORIGINS=

# Cadastro de novas contas.
# 1 = qualquer pessoa na rede pode criar conta; 0 = cadastro desativado (403), contas
# existentes continuam funcionando. Feche depois de criar as contas da casa.
GRANA_CADASTRO_ABERTO=1

# Sessão (login).
# Duração da credencial de acesso, em minutos (inteiro ≥ 1).
GRANA_SESSAO_ACESSO_MINUTOS=30
# Por quanto tempo a pessoa fica conectada sem digitar a senha, em dias (inteiro ≥ 1).
GRANA_SESSAO_RENOVACAO_DIAS=7

# --- Portas no computador -----------------------------------------------------------------

# Porta da API (http://localhost:8000). Troque se estiver ocupada.
BACKEND_PORT=8000

# Porta da interface (http://localhost:5173). Troque se estiver ocupada.
FRONTEND_PORT=5173

# --- Frontend (React) ---------------------------------------------------------------------

# URL base da API, incluindo o /api (ex.: http://localhost:8000/api).
# Vazia = a interface chama /api no mesmo endereço em que foi aberta (recomendado).
VITE_API_URL=
